        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "print(\"Libraries imported successfully\")\n",
        "\n",
        "img = np.zeros((200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "print(\"Image shape:\", img.shape)\n",
        "print(\"Data type:\", img.dtype)\n",
        "print(\"Memory:\", img.nbytes, \"bytes\")\n",
        "\n",
        "plt.imshow(img)\n",
        "plt.title(\"Blank Image\")\n",
        "plt.show()\n",
        "\n",
        "img1 = np.ones((200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "plt.imshow(img1)\n",
        "plt.title(\"Image Using Ones\")\n",
        "plt.show()\n",
        "\n",
        "img2 = np.full((200, 200, 3), 255, dtype=np.uint8)\n",
        "\n",
        "plt.imshow(img2)\n",
        "plt.title(\"White Image\")\n",
        "plt.show()\n",
        "\n",
        "img3 = np.random.randint(0, 256, (200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "plt.imshow(img3)\n",
        "plt.title(\"Random Image\")\n",
        "plt.show()\n",
        "\n",
        "img = np.zeros((200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "img[10:60, 20:90] = [255, 0, 0]\n",
        "img[70:120, 20:90] = [0, 255, 0]\n",
        "img[130:180, 20:90] = [0, 0, 255]\n",
        "\n",
        "img[10:180, 110:130] = [255, 255, 0]\n",
        "img[10:180, 150:170] = [255, 255, 255]\n",
        "\n",
        "plt.imshow(img)\n",
        "plt.title(\"Color Blocks\")\n",
        "plt.show()\n",
        "\n",
        "crop = img[10:100, 20:100]\n",
        "\n",
        "print(\"Original shape:\", img.shape)\n",
        "print(\"Cropped shape:\", crop.shape)\n",
        "\n",
        "plt.imshow(crop)\n",
        "plt.title(\"Cropped Image\")\n",
        "plt.show()\n",
        "\n",
        "flip_horizontal = img[:, ::-1, :]\n",
        "flip_vertical = img[::-1, :, :]\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.imshow(img)\n",
        "plt.title(\"Original\")\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.imshow(flip_horizontal)\n",
        "plt.title(\"Horizontal Flip\")\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.imshow(flip_vertical)\n",
        "plt.title(\"Vertical Flip\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "red = img[:, :, 0]\n",
        "green = img[:, :, 1]\n",
        "blue = img[:, :, 2]\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.imshow(red, cmap=\"gray\", vmin=0, vmax=255)\n",
        "plt.title(\"Red Channel\")\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.imshow(green, cmap=\"gray\", vmin=0, vmax=255)\n",
        "plt.title(\"Green Channel\")\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.imshow(blue, cmap=\"gray\", vmin=0, vmax=255)\n",
        "plt.title(\"Blue Channel\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "img_float = img.astype(np.float32)\n",
        "\n",
        "bright = np.clip(img_float * 1.5, 0, 255).astype(np.uint8)\n",
        "dark = np.clip(img_float * 0.5, 0, 255).astype(np.uint8)\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.imshow(img)\n",
        "plt.title(\"Original\")\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.imshow(bright)\n",
        "plt.title(\"Bright Image\")\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.imshow(dark)\n",
        "plt.title(\"Dark Image\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "intensity = img.mean(axis=2)\n",
        "\n",
        "mask = intensity > 200\n",
        "\n",
        "print(\"Bright pixels:\", np.sum(mask))\n",
        "\n",
        "plt.imshow(mask, cmap=\"gray\")\n",
        "plt.title(\"Bright Pixel Mask\")\n",
        "plt.show()\n",
        "\n",
        "a = np.zeros((200, 200, 3), dtype=np.uint8)\n",
        "b = np.zeros((200, 200, 3), dtype=np.float32)\n",
        "c = np.zeros((200, 200, 3), dtype=np.float64)\n",
        "\n",
        "print(\"uint8 memory:\", a.nbytes, \"bytes\")\n",
        "print(\"float32 memory:\", b.nbytes, \"bytes\")\n",
        "print(\"float64 memory:\", c.nbytes, \"bytes\")\n",
        "\n",
        "plt.imshow(img)\n",
        "plt.title(\"Final Image\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Image Pixel Manipulator completed successfully\")\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "gray = img.mean(axis=2).astype(np.uint8)\n",
        "\n",
        "plt.imshow(gray, cmap=\"gray\")\n",
        "plt.title(\"Grayscale Image\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "red_img = np.zeros_like(img)\n",
        "red_img[:, :, 0] = img[:, :, 0]\n",
        "\n",
        "green_img = np.zeros_like(img)\n",
        "green_img[:, :, 1] = img[:, :, 1]\n",
        "\n",
        "blue_img = np.zeros_like(img)\n",
        "blue_img[:, :, 2] = img[:, :, 2]\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "\n",
        "plt.subplot(1, 3, 1)\n",
        "plt.imshow(red_img)\n",
        "plt.title(\"Red Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1, 3, 2)\n",
        "plt.imshow(green_img)\n",
        "plt.title(\"Green Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1, 3, 3)\n",
        "plt.imshow(blue_img)\n",
        "plt.title(\"Blue Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "gradient = np.zeros((200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "for i in range(200):\n",
        "    gradient[:, i, 0] = i\n",
        "    gradient[:, i, 1] = 255 - i\n",
        "    gradient[:, i, 2] = 100\n",
        "\n",
        "plt.imshow(gradient)\n",
        "plt.title(\"Gradient Image\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "border_img = img.copy()\n",
        "\n",
        "border_img[:5, :] = 0\n",
        "border_img[-5:, :] = 0\n",
        "border_img[:, :5] = 0\n",
        "border_img[:, -5:] = 0\n",
        "\n",
        "plt.imshow(border_img)\n",
        "plt.title(\"Image with Black Border\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "new_img = img.copy()\n",
        "\n",
        "mask = (\n",
        "    (new_img[:, :, 0] == 255) &\n",
        "    (new_img[:, :, 1] == 0) &\n",
        "    (new_img[:, :, 2] == 0)\n",
        ")\n",
        "\n",
        "new_img[mask] = [255, 255, 0]\n",
        "\n",
        "plt.imshow(new_img)\n",
        "plt.title(\"Red Changed to Yellow\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "inverted = 255 - img\n",
        "\n",
        "plt.imshow(inverted)\n",
        "plt.title(\"Inverted Colors\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "random_img = np.random.randint(\n",
        "    0, 256, (200, 200, 3), dtype=np.uint8\n",
        ")\n",
        "\n",
        "plt.imshow(random_img)\n",
        "plt.title(\"Random Color Image\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Image Height:\", img.shape[0])\n",
        "print(\"Image Width:\", img.shape[1])\n",
        "print(\"Number of Channels:\", img.shape[2])\n",
        "print(\"Image Data Type:\", img.dtype)\n",
        "print(\"Total Pixels:\", img.shape[0] * img.shape[1])\n",
        "print(\"Memory Used:\", img.nbytes, \"bytes\")\n",
        "\n",
        "img_float = img.astype(np.float32)\n",
        "\n",
        "contrast = np.clip(\n",
        "    (img_float - 128) * 1.5 + 128,\n",
        "    0, 255\n",
        ").astype(np.uint8)\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.imshow(img)\n",
        "plt.title(\"Original Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.imshow(contrast)\n",
        "plt.title(\"High Contrast Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "checker = np.zeros((200, 200, 3), dtype=np.uint8)\n",
        "\n",
        "for i in range(0, 200, 20):\n",
        "    for j in range(0, 200, 20):\n",
        "        if (i // 20 + j // 20) % 2 == 0:\n",
        "            checker[i:i+20, j:j+20] = [255, 255, 255]\n",
        "\n",
        "plt.imshow(checker)\n",
        "plt.title(\"Checkerboard Image\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "print(\"PROJECT: IMAGE PIXEL MANIPULATOR\")\n",
        "print(\"--------------------------------\")\n",
        "print(\"1. Image Creation\")\n",
        "print(\"2. Color Blocks\")\n",
        "print(\"3. Cropping\")\n",
        "print(\"4. Image Flipping\")\n",
        "print(\"5. RGB Channel Extraction\")\n",
        "print(\"6. Brightness Adjustment\")\n",
        "print(\"7. Boolean Masking\")\n",
        "print(\"8. Memory Comparison\")\n",
        "print(\"9. Grayscale Conversion\")\n",
        "print(\"10. Color Inversion\")\n",
        "print(\"11. Contrast Adjustment\")\n",
        "print(\"12. Gradient Generation\")\n",
        "print(\"--------------------------------\")\n",
        "print(\"All operations completed!\")"
